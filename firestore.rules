rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole() { return me().role; }
    // .get(key, default) is used everywhere for optional fields (orgId,
    // departmentIds, projectIds, departmentId, projectId) so that documents
    // predating this feature (which genuinely lack these fields, as opposed
    // to having them explicitly null) never cause a rule evaluation error â€”
    // they safely fall back to null/[] and keep behaving exactly as before.
    function myOrgId() { return me().get('orgId', null); }
    function myDeptIds() { return me().get('departmentIds', []); }
    function myProjectIds() { return me().get('projectIds', []); }
    function isMasterAdmin() { return isSignedIn() && myRole() == 'master-admin'; }
    function isOrgMember(orgId) { return isSignedIn() && myOrgId() == orgId; }
    function isOrgAdmin(orgId) { return isOrgMember(orgId) && myRole() in ['org-admin', 'admin']; }
    function isDeptMember(orgId, deptId) { return isOrgMember(orgId) && deptId in myDeptIds(); }
    function isProjectMember(orgId, projId) { return isOrgMember(orgId) && projId in myProjectIds(); }
    function isDeptHead() { return isSignedIn() && myRole() == 'department-head'; }
    function isManager() { return isSignedIn() && myRole() == 'manager'; }
    // Client: external stakeholder, read-only, scoped to their assigned projects.
    function isClient() { return isSignedIn() && myRole() == 'client'; }

    // ---- Task-scoped helpers ------------------------------------------------
    function taskData(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }
    // Same visibility as the tasks read rule, over any task data map.
    function taskVisible(t) {
      return isOrgAdmin(t.get('orgId', null))
        || isMasterAdmin()
        || isDeptMember(t.get('orgId', null), t.get('departmentId', null))
        || isProjectMember(t.get('orgId', null), t.get('projectId', null))
        || t.get('assignedTo', null) == request.auth.uid
        || t.get('createdBy', null) == request.auth.uid;
    }
    // Child documents (subtasks, comments, attachments) carry only a taskId, so
    // access is derived from the parent task instead of trusting a client field.
    // Clients never see internal task conversation.
    function canSeeTask(taskId) {
      return isSignedIn() && !isClient() && taskVisible(taskData(taskId));
    }
    function projectDept(orgId, projId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projId)).data.get('departmentId', null);
    }
    // Is (dept, proj) inside the caller's own scope? Org-admins: always.
    // A manager owns their projects (and the project's department is implied);
    // a department head owns their departments and every project inside them.
    function inScope(orgId, deptId, projId) {
      return isOrgAdmin(orgId)
        || ((projId == null || projId in myProjectIds()
              || (isDeptHead() && projectDept(orgId, projId) in myDeptIds()))
            && (deptId == null || deptId in myDeptIds()
              || (projId != null && projId in myProjectIds())));
    }
    function scopeUnchangedOrOk(orgId) {
      return (request.resource.data.get('departmentId', null) == resource.data.get('departmentId', null)
              && request.resource.data.get('projectId', null) == resource.data.get('projectId', null))
        || inScope(orgId, request.resource.data.get('departmentId', null), request.resource.data.get('projectId', null));
    }
    function canManageProjectMoney(orgId, projId) {
      return isMasterAdmin()
        || isOrgAdmin(orgId)
        || (isManager() && isProjectMember(orgId, projId))
        || (isDeptHead() && isOrgMember(orgId) && projectDept(orgId, projId) in myDeptIds());
    }

    // Organizations
    match /organizations/{orgId} {
      // Every member (clients included) may read their own org document; the
      // portal header shows the organization name.
      allow read: if isOrgMember(orgId) || isMasterAdmin();
      allow write: if isMasterAdmin();

      // Reading is scoped to the organization, not to the individual
      // department or project. (Testing `deptId in myDeptIds()` here used to
      // evaluate `null in [...]` on list queries and surface as
      // permission-denied, so dropdowns came back empty.) Both collections hold
      // names/metadata only; what needs finer scoping is the tasks and users
      // inside them, and that is enforced on those collections.
      //
      // Clients are org members too, so they are carved out of the org-wide
      // branch: a client may only read the projects they are linked to, and
      // must fetch them by id (a list query cannot prove `projId in ids`).
      match /departments/{deptId} {
        allow read: if (isOrgMember(orgId) && !isClient()) || isMasterAdmin();
        allow write: if isOrgAdmin(orgId) || isMasterAdmin();
      }
      match /projects/{projId} {
        allow read: if (isOrgMember(orgId) && !isClient())
          || isMasterAdmin()
          || (isClient() && isOrgMember(orgId) && projId in myProjectIds());
        allow write: if isOrgAdmin(orgId) || isMasterAdmin();

        // Budget expenses are financial data: org-admins, plus the manager of
        // this project and the head of its department. Staff and clients have
        // no access.
        match /expenses/{expId} {
          allow read: if canManageProjectMoney(orgId, projId);
          allow create: if canManageProjectMoney(orgId, projId)
            && request.resource.data.addedBy == request.auth.uid
            && request.resource.data.amount is number
            && request.resource.data.amount >= 0
            && request.resource.data.description is string;
          allow update: if isOrgAdmin(orgId) || isMasterAdmin();
          allow delete: if isOrgAdmin(orgId) || isMasterAdmin()
            || (resource.data.get('addedBy', null) == request.auth.uid
                && canManageProjectMoney(orgId, projId));
        }
      }
    }

    // Users â€” primary collection for the admin/staff app.
    // Org-scoped: an org-admin only sees/manages users in their OWN org (matched
    // via orgId equality â€” legacy pre-org accounts have orgId==null on both sides,
    // so old admin/staff behavior keeps working unchanged for them).
    match /users/{uid} {
      // Clients may only read their own user document (to restore session / get their projectIds).
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || (!isClient() && isOrgAdmin(resource.data.get('orgId', null)))
        || isMasterAdmin()
        || (isDeptHead() && isOrgMember(resource.data.get('orgId', null)) && resource.data.get('departmentIds', []).hasAny(myDeptIds()))
        || (isManager() && isOrgMember(resource.data.get('orgId', null)) && resource.data.get('projectIds', []).hasAny(myProjectIds()))
      );

      // Creation: master-admin creates any role in any org. An org-admin creates
      // department-head/manager/staff within their OWN org only (never another
      // org-admin/master-admin â€” that's master-admin's job via org provisioning).
      // Department-heads/managers may create staff scoped to their own department/project.
      allow create: if isMasterAdmin()
        || (isOrgAdmin(request.resource.data.get('orgId', null))
            && request.resource.data.role in ['department-head', 'manager', 'staff', 'client'])
        || (isDeptHead() && isOrgMember(request.resource.data.get('orgId', null))
            && request.resource.data.role == 'staff'
            && request.resource.data.get('departmentIds', []).hasAny(myDeptIds()))
        || (isManager() && isOrgMember(request.resource.data.get('orgId', null))
            && request.resource.data.role == 'staff'
            && request.resource.data.get('projectIds', []).hasAny(myProjectIds()));

      // Department heads and managers run their own scope, so they may remove
      // staff from it â€” but only staff, and only people already inside that
      // scope. They can never remove a peer or anyone senior.
      allow delete: if isOrgAdmin(resource.data.get('orgId', null))
        || isMasterAdmin()
        || (isDeptHead() && isOrgMember(resource.data.get('orgId', null))
            && resource.data.role == 'staff'
            && resource.data.get('departmentIds', []).hasAny(myDeptIds()))
        || (isManager() && isOrgMember(resource.data.get('orgId', null))
            && resource.data.role == 'staff'
            && resource.data.get('projectIds', []).hasAny(myProjectIds()));

      // Update: master-admin can change anything. An org-admin can update
      // mid-tier/staff users in their OWN org, but must NOT elevate anyone to
      // org-admin/master-admin (privilege escalation) and must not move a user
      // to another org â€” so BOTH the current and resulting role are constrained
      // to the mid-tier/staff set. A user may update their OWN document but must
      // not change their role, status, org, or department/project membership
      // (the latter two would self-grant access to other scopes' data).
      allow update: if isMasterAdmin()
        || (isOrgAdmin(resource.data.get('orgId', null))
            && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            && resource.data.role in ['department-head', 'manager', 'staff', 'client']
            && request.resource.data.role in ['department-head', 'manager', 'staff', 'client'])
        // A head or manager may edit staff inside their own scope. The role is
        // pinned to 'staff' on BOTH sides, so this can never be used to promote
        // anyone â€” including themselves â€” and the target must still be in their
        // scope afterwards, so a member cannot be moved out of reach or a
        // stranger pulled in.
        || (isDeptHead() && isOrgMember(resource.data.get('orgId', null))
            && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            && resource.data.role == 'staff'
            && request.resource.data.role == 'staff'
            && resource.data.get('departmentIds', []).hasAny(myDeptIds())
            && request.resource.data.get('departmentIds', []).hasAny(myDeptIds()))
        || (isManager() && isOrgMember(resource.data.get('orgId', null))
            && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            && resource.data.role == 'staff'
            && request.resource.data.role == 'staff'
            && resource.data.get('projectIds', []).hasAny(myProjectIds())
            && request.resource.data.get('projectIds', []).hasAny(myProjectIds()))
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            && request.resource.data.get('departmentIds', []) == resource.data.get('departmentIds', [])
            && request.resource.data.get('projectIds', []) == resource.data.get('projectIds', []));
    }

    // Tasks - primary collection for the admin/staff app.
    // Org-scoped the same way as users; department-heads/managers get scoped
    // read + content/status update access but cannot reassign a task's
    // department/project outside their own scope.
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        taskVisible(resource.data)
        // Clients: read-only access to tasks in their assigned projects only.
        || (isClient()
            && isOrgMember(resource.data.get('orgId', null))
            && resource.data.get('projectId', null) in myProjectIds())
      );
      // Creation is confined to the creator's OWN organization, and to their own
      // department/project scope (an org-admin may place a task anywhere in the
      // org). A bare `createdBy == uid` check would otherwise let any signed-in
      // user plant a task inside another organization or another team's project.
      // Clients have no write access to tasks whatsoever.
      allow create: if isSignedIn() && !isClient() && (
        isMasterAdmin()
        || (isOrgMember(request.resource.data.get('orgId', null))
            && request.resource.data.createdBy == request.auth.uid
            && inScope(request.resource.data.get('orgId', null),
                       request.resource.data.get('departmentId', null),
                       request.resource.data.get('projectId', null)))
      );

      // Only a master-admin may move a task between organizations.
      //  - org-admin: anything within the org.
      //  - dept-head / manager on a task in their scope, and the task's creator:
      //    may edit, but the task must stay inside their scope and its
      //    author is fixed.
      //  - the assignee: may update progress on the task but cannot re-home or
      //    reassign it.
      allow update: if isSignedIn() && !isClient() && (
        isMasterAdmin()
        || (
          request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
          && (
            isOrgAdmin(resource.data.get('orgId', null))
            || (request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
                && scopeUnchangedOrOk(resource.data.get('orgId', null))
                && (isDeptMember(resource.data.get('orgId', null), resource.data.get('departmentId', null))
                    || isProjectMember(resource.data.get('orgId', null), resource.data.get('projectId', null))
                    || resource.data.get('createdBy', null) == request.auth.uid))
            || (resource.data.get('assignedTo', null) == request.auth.uid
                && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
                && request.resource.data.get('assignedTo', null) == resource.data.get('assignedTo', null)
                && request.resource.data.get('departmentId', null) == resource.data.get('departmentId', null)
                && request.resource.data.get('projectId', null) == resource.data.get('projectId', null))
          )
        )
      );
      // Department-heads and managers own the tasks inside their scope, so they
      // may delete them - not just the ones they personally created.
      allow delete: if isSignedIn() && !isClient() && (
        isOrgAdmin(resource.data.get('orgId', null))
        || isMasterAdmin()
        || isDeptMember(resource.data.get('orgId', null), resource.data.get('departmentId', null))
        || isProjectMember(resource.data.get('orgId', null), resource.data.get('projectId', null))
        || resource.data.get('createdBy', null) == request.auth.uid
      );
    }

    // Subtasks, comments and attachments belong to a task and inherit its
    // visibility (see canSeeTask). Previously any signed-in user of any
    // organization could read and write every one of them.
    match /subtasks/{subtaskId} {
      allow read: if canSeeTask(resource.data.get('taskId', null));
      allow create: if canSeeTask(request.resource.data.get('taskId', null));
      allow update: if canSeeTask(resource.data.get('taskId', null))
        && request.resource.data.get('taskId', null) == resource.data.get('taskId', null);
      allow delete: if canSeeTask(resource.data.get('taskId', null));
    }

    // Task comments. Clients cannot read or write comments; the portal shows
    // task status and timeline only.
    match /task_comments/{commentId} {
      allow read: if canSeeTask(resource.data.get('taskId', null));
      allow create: if canSeeTask(request.resource.data.get('taskId', null))
        && request.resource.data.get('userId', null) == request.auth.uid;
      allow update: if resource.data.get('userId', null) == request.auth.uid
        && canSeeTask(resource.data.get('taskId', null))
        && request.resource.data.get('taskId', null) == resource.data.get('taskId', null)
        && request.resource.data.get('userId', null) == resource.data.get('userId', null);
      allow delete: if isSignedIn() && (
        resource.data.get('userId', null) == request.auth.uid || isMasterAdmin()
      );
    }

    // Task attachments (metadata; the files live in Storage, see storage.rules)
    match /task_attachments/{attachmentId} {
      allow read: if canSeeTask(resource.data.get('taskId', null));
      allow create: if canSeeTask(request.resource.data.get('taskId', null))
        && request.resource.data.get('uploadedBy', null) == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.get('uploadedBy', null) == request.auth.uid || isMasterAdmin()
      );
    }

    // @mention notifications. A notification may only be addressed to someone in
    // the sender's own organization and attributed to the sender; the recipient
    // may then read it, flip its `read` flag, or delete it - nothing else.
    match /comment_notifications/{notificationId} {
      allow read, delete: if isSignedIn() && resource.data.get('userId', null) == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.get('userId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn() && !isClient()
        && request.resource.data.get('mentionedBy', null) == request.auth.uid
        && request.resource.data.get('userId', null) is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.get('orgId', null) == myOrgId();
    }

    // Org usage stats â€” master-admin only
    match /org_usage_stats/{orgId} {
      allow read, write: if isMasterAdmin();
    }

    // Audit logs.
    // Master-admin sees everything. Org-admins may append entries for their own
    // organization and read that organization's history, so account changes are
    // accountable at the org level too. Entries are append-only: nobody may
    // edit or delete history, and an org-admin cannot forge another org's log.
    match /audit_logs/{logId} {
      allow read: if isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null));
      allow create: if isMasterAdmin()
        || (isOrgAdmin(request.resource.data.get('orgId', null))
            && request.resource.data.actorId == request.auth.uid);
      allow update, delete: if false;
    }

    // Unhandled UI errors, written by the ErrorBoundary.
    // Any signed-in user may report one (a crash can happen on any screen), but
    // only a master-admin may read them: stacks and URLs can reveal other
    // organizations' data. Append-only â€” a report cannot be altered or removed,
    // so nobody can quietly erase evidence of a failure.
    match /error_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isMasterAdmin();
      allow update, delete: if false;
    }

    // Outgoing email queue.
    //
    // The browser cannot send email, so it appends a request here and a
    // scheduled job delivers it through Gmail. That makes this collection the
    // one place a signed-in user can cause mail to leave the system, so the
    // shape is pinned down rather than trusted:
    //  - the request must be attributable to the caller (requestedBy == uid),
    //    so a queued email can never be blamed on someone else
    //  - it must start unsent, so nobody can pre-mark their own request
    //    delivered and skip the record of it
    //  - a recipient and a subject line are required, so an empty or
    //    malformed job cannot sit in the queue failing forever
    //  - nobody may read the queue: payloads carry names, task titles and
    //    addresses from whichever org queued them
    // Only the drain job (Admin SDK, which bypasses rules) marks them sent.
    match /mail_queue/{mailId} {
      // Beyond the shape checks, a request must be tied to a task the caller can
      // actually see (so a signed-in user cannot fire arbitrary mail at arbitrary
      // people), may not choose its own CC list (that is looked up per
      // organization by the drain job), and may only carry the known template
      // fields. The drain job additionally verifies that the recipient is an
      // active member of the task organization before anything is sent.
      allow create: if isSignedIn()
        && !isClient()
        && request.resource.data.keys().hasOnly([
             'to_email', 'to_name', 'cc_email', 'notification_type', 'notification_icon',
             'notification_color', 'title', 'message',
             'detail_1_label', 'detail_1_value', 'detail_2_label', 'detail_2_value',
             'detail_3_label', 'detail_3_value', 'detail_4_label', 'detail_4_value',
             'detail_5_label', 'detail_5_value', 'button_text', 'button_link', 'footer_text',
             'status', 'attempts', 'requestedBy', 'requestedAt', 'type', 'taskId', 'source'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.attempts == 0
        && request.resource.data.to_email is string
        && request.resource.data.to_email.size() > 3
        && request.resource.data.to_email.size() < 200
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.notification_type is string
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 1000
        && request.resource.data.get('cc_email', '') == ''
        && request.resource.data.get('taskId', null) is string
        && canSeeTask(request.resource.data.taskId);
      allow read, update, delete: if false;
    }

    // Login attempts â€” Cloud Functions (Admin SDK) only
    match /login_attempts/{doc} {
      allow read, write: if false;
    }

    // Username lookup â€” readable by signed-in users, written server-side only
    match /usernames/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Designations (job titles) are per-organization. A designation without an
    // orgId is legacy data awaiting scripts/admin/backfill-designation-org.mjs.
    match /designations/{designationId} {
      allow read: if isSignedIn()
        && (isMasterAdmin() || isOrgMember(resource.data.get('orgId', null)));
      // Heads and managers hire into their own scope, so they need to be able
      // to add the job title they are hiring for without waiting on an admin.
      allow create: if isSignedIn()
        && myRole() in ['admin', 'org-admin', 'master-admin', 'department-head', 'manager']
        && (isMasterAdmin() || request.resource.data.get('orgId', null) == myOrgId());
      allow update: if isSignedIn()
        && myRole() in ['admin', 'org-admin', 'master-admin', 'department-head', 'manager']
        && (isMasterAdmin() || resource.data.get('orgId', null) == myOrgId())
        && request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
      allow delete: if isSignedIn()
        && myRole() in ['admin', 'org-admin', 'master-admin', 'department-head', 'manager']
        && (isMasterAdmin() || resource.data.get('orgId', null) == myOrgId());
    }

    // Email logs
    match /email_logs/{logId} {
      // Scoped to the org-admin own organization (the drain job stamps orgId).
      allow read: if isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null));
      allow write: if false; // written server-side only
    }

    // Reminder logs
    match /reminder_logs/{date} {
      allow read: if isSignedIn() && myRole() in ['admin', 'org-admin', 'master-admin'];
      allow write: if false;
    }

    // User deletion markers.
    // On the Spark plan the client cannot delete a Firebase Auth account, so a
    // removed user leaves an orphaned sign-in that keeps their email reserved.
    // Admins record and later clear these markers; they are never deleted, so
    // the record of the removal survives.
    match /userDeletions/{uid} {
      allow read: if isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null));
      allow create: if isMasterAdmin() || isOrgAdmin(request.resource.data.get('orgId', null));
      // Only the cleanup bookkeeping may change â€” the identity fields are fixed.
      allow update: if (isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null)))
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
      allow delete: if false;
    }
  }
}




rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Two levels of "signed in":
    //  - authed(): cheap, just an authenticated request. Used inside the role and
    //    scope helpers below.
    //  - isSignedIn(): authed() AND the account is not deactivated AND its
    //    organization is not suspended. Every rule starts with it, ONCE.
    // The Firestore rules engine stops after 1000 expression evaluations per
    // request and does not memoize function bodies, so the heavier check must not
    // be re-run from every helper.
    //
    // A deactivated account is treated as signed out everywhere, so an admin
    // deactivating someone actually cuts their data access (not just the login
    // form). The one exception is reading their own profile, so the app can
    // tell them why they were turned away. Likewise a member of a SUSPENDED
    // organization loses access to everything (the org document itself stays
    // readable, see the organizations rule, so the app can say why).
    function authed() { return request.auth != null; }
    function myOrgSuspended() {
      return myOrgId() != null
        && exists(/databases/$(database)/documents/organizations/$(myOrgId()))
        && get(/databases/$(database)/documents/organizations/$(myOrgId())).data.get('status', 'active') == 'suspended';
    }
    function isSignedIn() {
      return request.auth != null
        && me().get('status', 'active') != 'inactive'
        && !myOrgSuspended();
    }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole() { return me().role; }
    // .get(key, default) is used everywhere for optional fields (orgId,
    // departmentIds, projectIds, departmentId, projectId) so that documents
    // predating this feature (which genuinely lack these fields, as opposed
    // to having them explicitly null) never cause a rule evaluation error â€”
    // they safely fall back to null/[] and keep behaving exactly as before.
    function myOrgId() { return me().get('orgId', null); }
    function myDeptIds() { return me().get('departmentIds', []); }
    function myProjectIds() { return me().get('projectIds', []); }
    function isMasterAdmin() { return authed() && myRole() == 'master-admin'; }
    function isOrgMember(orgId) { return authed() && myOrgId() == orgId; }
    function isOrgAdmin(orgId) { return isOrgMember(orgId) && myRole() in ['org-admin', 'admin']; }
    function isDeptMember(orgId, deptId) { return isOrgMember(orgId) && deptId in myDeptIds(); }
    function isProjectMember(orgId, projId) { return isOrgMember(orgId) && projId in myProjectIds(); }
    function isDeptHead() { return authed() && myRole() == 'department-head'; }
    function isManager() { return authed() && myRole() == 'manager'; }
    // Client: external stakeholder, read-only, scoped to their assigned projects.
    function isClient() { return authed() && myRole() == 'client'; }

    // ---- Task-scoped helpers ------------------------------------------------
    function taskData(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }
    // Same visibility as the tasks read rule, over any task data map.
    function taskVisible(t) {
      return isOrgAdmin(t.get('orgId', null))
        || isMasterAdmin()
        || isDeptMember(t.get('orgId', null), t.get('departmentId', null))
        || isProjectMember(t.get('orgId', null), t.get('projectId', null))
        || t.get('assignedTo', null) == request.auth.uid
        || t.get('createdBy', null) == request.auth.uid;
    }
    // Child documents (subtasks, comments, attachments) carry only a taskId, so
    // access is derived from the parent task instead of trusting a client field.
    // Clients never see internal task conversation.
    function canSeeTask(taskId) {
      return isSignedIn() && !isClient() && taskVisible(taskData(taskId));
    }
    function projectDept(orgId, projId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/projects/$(projId)).data.get('departmentId', null);
    }
    // Is (dept, proj) inside the caller's own scope? Org-admins: always.
    // A manager owns their projects (and the project's department is implied);
    // a department head owns their departments and every project inside them.
    function inScope(orgId, deptId, projId) {
      return isOrgAdmin(orgId)
        || ((projId == null || projId in myProjectIds()
              || (isDeptHead() && projectDept(orgId, projId) in myDeptIds()))
            && (deptId == null || deptId in myDeptIds()
              || (projId != null && projId in myProjectIds())));
    }
    function scopeUnchangedOrOk(orgId) {
      return (request.resource.data.get('departmentId', null) == resource.data.get('departmentId', null)
              && request.resource.data.get('projectId', null) == resource.data.get('projectId', null))
        || inScope(orgId, request.resource.data.get('departmentId', null), request.resource.data.get('projectId', null));
    }
    function canManageProjectMoney(orgId, projId) {
      return isSignedIn() && (isMasterAdmin()
        || isOrgAdmin(orgId)
        || (isManager() && isProjectMember(orgId, projId))
        || (isDeptHead() && isOrgMember(orgId) && projectDept(orgId, projId) in myDeptIds()));
    }


    // ---- Seat accounting ----------------------------------------------------
    // organizations/{org}/meta/seats holds { seatsUsed, seatLimit, lastSeatUid }.
    // Creating a user must bump the counter by exactly one in the SAME batch, and
    // deleting one must lower it by one, so an org can never exceed its limit
    // through the app. The counter can only be moved together with a real user
    // document appearing or disappearing (see seatBump), so it cannot be
    // decremented on its own to make room. An organization with no seats document
    // is not yet under seat accounting and is unaffected.
    function seatsPath(orgId) { return /databases/$(database)/documents/organizations/$(orgId)/meta/seats; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function seatTaken(orgId, uid) {
      return !exists(seatsPath(orgId))
        || (getAfter(seatsPath(orgId)).data.seatsUsed == get(seatsPath(orgId)).data.seatsUsed + 1
            && getAfter(seatsPath(orgId)).data.seatsUsed <= get(seatsPath(orgId)).data.seatLimit
            && getAfter(seatsPath(orgId)).data.lastSeatUid == uid);
    }
    function seatFreed(orgId, uid) {
      // (a counter already at zero has drifted below the real headcount; removing a
      // person then cannot lower it further and must not be blocked)
      return !exists(seatsPath(orgId))
        || get(seatsPath(orgId)).data.seatsUsed <= 0
        || (getAfter(seatsPath(orgId)).data.seatsUsed == get(seatsPath(orgId)).data.seatsUsed - 1
            && getAfter(seatsPath(orgId)).data.lastSeatUid == uid);
    }
    function seatBump(orgId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seatsUsed', 'lastSeatUid'])
        && request.resource.data.lastSeatUid is string
        && ((request.resource.data.seatsUsed == resource.data.seatsUsed + 1
              && request.resource.data.seatsUsed <= resource.data.seatLimit
              && !exists(userPath(request.resource.data.lastSeatUid))
              && existsAfter(userPath(request.resource.data.lastSeatUid))
              && getAfter(userPath(request.resource.data.lastSeatUid)).data.get('orgId', null) == orgId)
            || (request.resource.data.seatsUsed == resource.data.seatsUsed - 1
              && request.resource.data.seatsUsed >= 0
              && exists(userPath(request.resource.data.lastSeatUid))
              && !existsAfter(userPath(request.resource.data.lastSeatUid))));
    }

    // The dept-head / manager whose scope a task sits in. Membership alone is NOT
    // ownership: isDeptMember/isProjectMember are true for every person in the
    // department or project, including ordinary staff, who must be able to see
    // their team's tasks but not edit or delete each other's work.
    function ownsScope(t) {
      return (isDeptHead() && isDeptMember(t.get('orgId', null), t.get('departmentId', null)))
        || (isManager() && isProjectMember(t.get('orgId', null), t.get('projectId', null)));
    }

    // Who may clear a task's conversation when the task is removed: the admins and
    // the head/manager whose scope the task sits in.
    function canModerateTask(t) {
      return isMasterAdmin()
        || isOrgAdmin(t.get('orgId', null))
        || (isDeptHead() && isDeptMember(t.get('orgId', null), t.get('departmentId', null)))
        || (isManager() && isProjectMember(t.get('orgId', null), t.get('projectId', null)));
    }

    // Organizations
    match /organizations/{orgId} {
      // Every member (clients included) may read their own org document; the
      // portal header shows the organization name.
      allow read: if (authed() && myOrgId() == orgId) || (isSignedIn() && isMasterAdmin());
      allow write: if isSignedIn() && isMasterAdmin();

      // Reading is scoped to the organization, not to the individual
      // department or project. (Testing `deptId in myDeptIds()` here used to
      // evaluate `null in [...]` on list queries and surface as
      // permission-denied, so dropdowns came back empty.) Both collections hold
      // names/metadata only; what needs finer scoping is the tasks and users
      // inside them, and that is enforced on those collections.
      //
      // Clients are org members too, so they are carved out of the org-wide
      // branch: a client may only read the projects they are linked to, and
      // must fetch them by id (a list query cannot prove `projId in ids`).
      match /departments/{deptId} {
        allow read: if isSignedIn() && ((isOrgMember(orgId) && !isClient()) || isMasterAdmin());
        allow write: if isSignedIn() && (isOrgAdmin(orgId) || isMasterAdmin());
      }
      // Billing contact, CC list, storage and the like: org-admins and master-admin
      // only. These used to sit on the organization document, which every member
      // (clients included) can read.
      match /private/{docId} {
        allow read: if isSignedIn() && (isMasterAdmin() || isOrgAdmin(orgId));
        allow write: if isSignedIn() && isMasterAdmin();
      }

      // Seat counter (see seatBump). Readable by members so user creation can
      // check availability; only movable in step with a user being added/removed.
      match /meta/{docId} {
        allow read: if isSignedIn() && !isClient() && (isOrgMember(orgId) || isMasterAdmin());
        allow create, delete: if isSignedIn() && isMasterAdmin();
        allow update: if isSignedIn() && (isMasterAdmin()
          || (docId == 'seats' && isOrgMember(orgId) && !isClient() && seatBump(orgId)));
      }

      // Task templates: reusable plans of tasks. Everyone inside the organisation who plans
      // work may read them; admins, department heads and managers may save them; the author
      // or an org-admin may change or remove one. Clients never see them.
      match /templates/{templateId} {
        allow read: if isSignedIn() && !isClient() && (isOrgMember(orgId) || isMasterAdmin());
        allow create: if isSignedIn() && isOrgMember(orgId)
          && myRole() in ['org-admin', 'admin', 'department-head', 'manager']
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 300;
        allow update: if isSignedIn()
          && (isOrgAdmin(orgId) || (isOrgMember(orgId) && resource.data.createdBy == request.auth.uid))
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 300;
        allow delete: if isSignedIn() && (isOrgAdmin(orgId) || isMasterAdmin()
          || (isOrgMember(orgId) && resource.data.createdBy == request.auth.uid));
      }

      // The client portal's look (logo, accent colour, welcome note). Every member,
      // clients included, reads it; org admins set it. The logo is a small raster data
      // URL (no Cloud Storage on this plan), so its type and size are pinned here.
      match /branding/{docId} {
        allow read: if isSignedIn() && (isOrgMember(orgId) || isMasterAdmin());
        allow write: if isSignedIn() && (isOrgAdmin(orgId) || isMasterAdmin())
          && docId == 'portal'
          && request.resource.data.keys().hasOnly(['accent', 'logo', 'welcome', 'updatedBy', 'updatedAt'])
          && (request.resource.data.get('accent', null) == null
              || (request.resource.data.accent is string && request.resource.data.accent.matches('^#[0-9a-f]{6}$')))
          && (request.resource.data.get('logo', null) == null
              || (request.resource.data.logo is string
                  && request.resource.data.logo.size() <= 150000
                  && request.resource.data.logo.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')))
          && request.resource.data.get('welcome', '') is string
          && request.resource.data.get('welcome', '').size() <= 500;
      }

      match /projects/{projId} {
        allow read: if isSignedIn() && ((isOrgMember(orgId) && !isClient())
          || isMasterAdmin()
          || (isClient() && isOrgMember(orgId) && projId in myProjectIds()));
        allow write: if isSignedIn() && (isOrgAdmin(orgId) || isMasterAdmin());

        // Budget expenses are financial data: org-admins, plus the manager of
        // this project and the head of its department. Staff and clients have
        // no access.
        // Budget figures (moved off the project document, which all members can read).
        match /finance/{docId} {
          allow read: if canManageProjectMoney(orgId, projId);
          allow write: if isSignedIn() && (isOrgAdmin(orgId) || isMasterAdmin());
        }

        // Saved plans of the project (baselines), to compare the schedule against. The team
        // reads them (clients do not); whoever runs the project saves one, as themselves at
        // the server's time, or deletes one. A baseline is never edited.
        match /baselines/{baselineId} {
          allow read: if isSignedIn() && ((isOrgMember(orgId) && !isClient()) || isMasterAdmin());
          allow create: if canManageProjectMoney(orgId, projId)
            && request.resource.data.keys().hasOnly(['name', 'tasks', 'createdBy', 'createdByName', 'createdAt'])
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 80
            && request.resource.data.createdByName is string
            && request.resource.data.createdByName.size() <= 120
            && request.resource.data.tasks is map
            && request.resource.data.tasks.size() <= 500;
          allow delete: if canManageProjectMoney(orgId, projId);
          allow update: if false;
        }

        // Status updates (portfolio health): whoever runs the project posts how it is doing
        // (on track / at risk / off track, and a short summary), as themselves at the
        // server's time. The team reads them; clients do not. A record: never edited; the
        // author or an org admin may remove one.
        match /updates/{updateId} {
          allow read: if isSignedIn() && ((isOrgMember(orgId) && !isClient()) || isMasterAdmin());
          allow create: if canManageProjectMoney(orgId, projId)
            && request.resource.data.keys().hasOnly(['health', 'summary', 'createdBy', 'createdByName', 'createdAt'])
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.health in ['on_track', 'at_risk', 'off_track']
            && request.resource.data.summary is string
            && request.resource.data.summary.size() <= 2000
            && request.resource.data.createdByName is string
            && request.resource.data.createdByName.size() <= 120;
          allow delete: if isSignedIn() && (isOrgAdmin(orgId) || isMasterAdmin()
            || resource.data.get('createdBy', null) == request.auth.uid);
          allow update: if false;
        }

        match /expenses/{expId} {
          allow read: if canManageProjectMoney(orgId, projId);
          allow create: if canManageProjectMoney(orgId, projId)
            && request.resource.data.addedBy == request.auth.uid
            && request.resource.data.amount is number
            && request.resource.data.amount >= 0
            && request.resource.data.description is string;
          allow update: if isSignedIn() && (isOrgAdmin(orgId) || isMasterAdmin());
          allow delete: if isSignedIn() && (isOrgAdmin(orgId) || isMasterAdmin()
            || (resource.data.get('addedBy', null) == request.auth.uid
                && canManageProjectMoney(orgId, projId)));
        }
      }
    }

    // Users â€” primary collection for the admin/staff app.
    // Org-scoped: an org-admin only sees/manages users in their OWN org (matched
    // via orgId equality â€” legacy pre-org accounts have orgId==null on both sides,
    // so old admin/staff behavior keeps working unchanged for them).
    match /users/{uid} {
      // Clients may only read their own user document (to restore session / get their projectIds).
      allow read: if (request.auth != null && request.auth.uid == uid)
        || (isSignedIn() && (
        false
        || (!isClient() && isOrgAdmin(resource.data.get('orgId', null)))
        || isMasterAdmin()
        || (isDeptHead() && isOrgMember(resource.data.get('orgId', null)) && resource.data.get('departmentIds', []).hasAny(myDeptIds()))
        || (isManager() && isOrgMember(resource.data.get('orgId', null)) && resource.data.get('projectIds', []).hasAny(myProjectIds()))
      ));

      // Creation: master-admin creates any role in any org. An org-admin creates
      // department-head/manager/staff within their OWN org only (never another
      // org-admin/master-admin â€” that's master-admin's job via org provisioning).
      // Department-heads/managers may create staff scoped to their own department/project.
      allow create: if isSignedIn() && (isMasterAdmin()
        || (isOrgAdmin(request.resource.data.get('orgId', null))
            && request.resource.data.role in ['department-head', 'manager', 'staff', 'client'])
        || (isDeptHead() && isOrgMember(request.resource.data.get('orgId', null))
            && request.resource.data.role == 'staff'
            && request.resource.data.get('departmentIds', []).hasAny(myDeptIds()))
        || (isManager() && isOrgMember(request.resource.data.get('orgId', null))
            && request.resource.data.role == 'staff'
            && request.resource.data.get('projectIds', []).hasAny(myProjectIds())))
        && (request.resource.data.get('orgId', null) == null
            || seatTaken(request.resource.data.orgId, uid));

      // Department heads and managers run their own scope, so they may remove
      // staff from it â€” but only staff, and only people already inside that
      // scope. They can never remove a peer or anyone senior.
      allow delete: if isSignedIn() && (isOrgAdmin(resource.data.get('orgId', null))
        || isMasterAdmin()
        || (isDeptHead() && isOrgMember(resource.data.get('orgId', null))
            && resource.data.role == 'staff'
            && resource.data.get('departmentIds', []).hasAny(myDeptIds()))
        || (isManager() && isOrgMember(resource.data.get('orgId', null))
            && resource.data.role == 'staff'
            && resource.data.get('projectIds', []).hasAny(myProjectIds())))
        && (resource.data.get('orgId', null) == null
            || seatFreed(resource.data.orgId, uid));

      // Update: master-admin can change anything. An org-admin can update
      // mid-tier/staff users in their OWN org, but must NOT elevate anyone to
      // org-admin/master-admin (privilege escalation) and must not move a user
      // to another org â€” so BOTH the current and resulting role are constrained
      // to the mid-tier/staff set. A user may update their OWN document but must
      // not change their role, status, org, or department/project membership
      // (the latter two would self-grant access to other scopes' data).
      allow update: if isSignedIn() && (isMasterAdmin()
        || (isOrgAdmin(resource.data.get('orgId', null))
            && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            && resource.data.role in ['department-head', 'manager', 'staff', 'client']
            && request.resource.data.role in ['department-head', 'manager', 'staff', 'client'])
        // A head or manager may edit staff inside their own scope. The role is
        // pinned to 'staff' on BOTH sides, so this can never be used to promote
        // anyone â€” including themselves â€” and the target must still be in their
        // scope afterwards, so a member cannot be moved out of reach or a
        // stranger pulled in.
        || (isDeptHead() && isOrgMember(resource.data.get('orgId', null))
            && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            && resource.data.role == 'staff'
            && request.resource.data.role == 'staff'
            && resource.data.get('departmentIds', []).hasAny(myDeptIds())
            && request.resource.data.get('departmentIds', []).hasAny(myDeptIds()))
        || (isManager() && isOrgMember(resource.data.get('orgId', null))
            && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            && resource.data.role == 'staff'
            && request.resource.data.role == 'staff'
            && resource.data.get('projectIds', []).hasAny(myProjectIds())
            && request.resource.data.get('projectIds', []).hasAny(myProjectIds()))
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
            && request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
            && request.resource.data.get('departmentIds', []) == resource.data.get('departmentIds', [])
            && request.resource.data.get('projectIds', []) == resource.data.get('projectIds', [])));
    }

    // Tasks - primary collection for the admin/staff app.
    // Org-scoped the same way as users; department-heads/managers get scoped
    // read + content/status update access but cannot reassign a task's
    // department/project outside their own scope.
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        taskVisible(resource.data)
        // Clients: read-only access to tasks in their assigned projects only.
        || (isClient()
            && isOrgMember(resource.data.get('orgId', null))
            && resource.data.get('projectId', null) in myProjectIds())
      );
      // Creation is confined to the creator's OWN organization, and to their own
      // department/project scope (an org-admin may place a task anywhere in the
      // org). A bare `createdBy == uid` check would otherwise let any signed-in
      // user plant a task inside another organization or another team's project.
      // Clients have no write access to tasks whatsoever.
      allow create: if isSignedIn() && !isClient() && (
        isMasterAdmin()
        || (isOrgMember(request.resource.data.get('orgId', null))
            && request.resource.data.createdBy == request.auth.uid
            && inScope(request.resource.data.get('orgId', null),
                       request.resource.data.get('departmentId', null),
                       request.resource.data.get('projectId', null)))
      );

      // Only a master-admin may move a task between organizations.
      //  - org-admin: anything within the org.
      //  - the dept-head / manager who owns the scope the task sits in, and the
      //    task's creator: may edit it, but it must stay inside their scope and its
      //    author is fixed.
      //  - the assignee: may only report progress (status and its timestamps). They
      //    cannot retitle, reprioritize, move the deadline, re-home or reassign work
      //    someone else gave them. (Being merely a member of the same department or
      //    project grants nothing here.)
      allow update: if isSignedIn() && !isClient() && (
        isMasterAdmin()
        || (
          request.resource.data.get('orgId', null) == resource.data.get('orgId', null)
          && (
            isOrgAdmin(resource.data.get('orgId', null))
            || (request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null)
                && scopeUnchangedOrOk(resource.data.get('orgId', null))
                && (ownsScope(resource.data)
                    || resource.data.get('createdBy', null) == request.auth.uid))
            || (resource.data.get('assignedTo', null) == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['status', 'completedAt', 'updatedAt']))
          )
        )
      );
      // A client's sign-off on a milestone of their own project, once the team has put it
      // up for review or finished it. Only the clientApproval field changes, it names the
      // client as the one deciding, and it carries the server's time. The same batch
      // records the decision in the client conversation (see client_messages).
      allow update: if isSignedIn() && isClient()
        && isOrgMember(resource.data.get('orgId', null))
        && resource.data.get('projectId', null) in myProjectIds()
        && resource.data.get('milestone', false) == true
        && resource.data.get('status', null) in ['review', 'completed']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientApproval'])
        && request.resource.data.clientApproval.keys().hasOnly(['decision', 'by', 'byName', 'at', 'note'])
        && request.resource.data.clientApproval.decision in ['approved', 'changes_requested']
        && request.resource.data.clientApproval.by == request.auth.uid
        && request.resource.data.clientApproval.at == request.time
        && request.resource.data.clientApproval.byName is string
        && request.resource.data.clientApproval.byName.size() <= 120
        && request.resource.data.clientApproval.note is string
        && request.resource.data.clientApproval.note.size() <= 2000;

      // Admins, the owner of the scope the task sits in, and the task's creator may
      // delete it. Ordinary members of the same department or project may not.
      allow delete: if isSignedIn() && !isClient() && (
        isOrgAdmin(resource.data.get('orgId', null))
        || isMasterAdmin()
        || ownsScope(resource.data)
        || resource.data.get('createdBy', null) == request.auth.uid
      );
    }

    // Subtasks, comments and attachments belong to a task and inherit its
    // visibility (see canSeeTask). Previously any signed-in user of any
    // organization could read and write every one of them.
    match /subtasks/{subtaskId} {
      allow read: if canSeeTask(resource.data.get('taskId', null));
      allow create: if canSeeTask(request.resource.data.get('taskId', null));
      allow update: if canSeeTask(resource.data.get('taskId', null))
        && request.resource.data.get('taskId', null) == resource.data.get('taskId', null);
      allow delete: if canSeeTask(resource.data.get('taskId', null));
    }

    // Task comments. Clients cannot read or write comments; the portal shows
    // task status and timeline only.
    match /task_comments/{commentId} {
      allow read: if canSeeTask(resource.data.get('taskId', null));
      allow create: if canSeeTask(request.resource.data.get('taskId', null))
        && request.resource.data.get('userId', null) == request.auth.uid;
      allow update: if resource.data.get('userId', null) == request.auth.uid
        && canSeeTask(resource.data.get('taskId', null))
        && request.resource.data.get('taskId', null) == resource.data.get('taskId', null)
        && request.resource.data.get('userId', null) == resource.data.get('userId', null);
      // The author, or whoever moderates the task (so deleting a task can clear
      // its conversation instead of leaving it orphaned).
      allow delete: if isSignedIn() && (
        resource.data.get('userId', null) == request.auth.uid
        || isMasterAdmin()
        || canModerateTask(taskData(resource.data.get('taskId', null)))
      );
    }

    // The conversation with a client about a task. Separate from task_comments on purpose:
    // nothing said inside the team can reach a client by accident. The clients of the
    // task's project and everyone who can see the task take part. It is a record kept with
    // an outside party, so nobody edits a message; an org admin may remove one. The mail
    // job (Admin SDK) flips `notified` once it has emailed the other side.
    match /client_messages/{messageId} {
      allow read: if isSignedIn() && (
        (isClient() && isOrgMember(resource.data.get('orgId', null))
          && resource.data.get('projectId', null) in myProjectIds())
        || (!isClient() && taskVisible(taskData(resource.data.get('taskId', null)))));

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['orgId', 'projectId', 'taskId', 'authorId', 'authorName',
             'fromClient', 'kind', 'text', 'notified', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.notified == false
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && request.resource.data.projectId is string
        && request.resource.data.orgId == taskData(request.resource.data.taskId).get('orgId', null)
        && request.resource.data.projectId == taskData(request.resource.data.taskId).get('projectId', null)
        && (
          // a client of the task's project
          (isClient()
            && isOrgMember(request.resource.data.orgId)
            && request.resource.data.projectId in myProjectIds()
            && request.resource.data.fromClient == true
            && ((request.resource.data.kind == 'message' && request.resource.data.text.size() > 0)
                // a sign-off is only recorded together with the decision on the task itself
                || (request.resource.data.kind in ['approved', 'changes_requested']
                    && getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.get('clientApproval', {}).get('by', null) == request.auth.uid
                    && getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.get('clientApproval', {}).get('decision', null) == request.resource.data.kind
                    && getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.get('clientApproval', {}).get('at', null) == request.time)))
          // or someone on the team who can see the task
          || (!isClient()
            && taskVisible(taskData(request.resource.data.taskId))
            && request.resource.data.fromClient == false
            && request.resource.data.kind == 'message'
            && request.resource.data.text.size() > 0)
        );
      allow update: if false;
      allow delete: if isSignedIn() && (isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null)));
    }

    // Requests a client sends from the portal. The people who run the project (its manager,
    // the head of its department, an org admin) see them and either accept one (it becomes
    // a task in the same project) or decline it, saying why. Nobody else on the team sees
    // them. A client sees their own projects' requests and may withdraw one while it is new.
    function canTriage(orgId, projId) {
      return isMasterAdmin() || isOrgAdmin(orgId)
        || (isManager() && isProjectMember(orgId, projId))
        || (isDeptHead() && isOrgMember(orgId) && projectDept(orgId, projId) in myDeptIds());
    }
    match /client_requests/{requestId} {
      allow read: if isSignedIn() && (
        (isClient() && isOrgMember(resource.data.get('orgId', null))
          && resource.data.get('projectId', null) in myProjectIds())
        || (!isClient() && canTriage(resource.data.get('orgId', null), resource.data.get('projectId', null))));

      allow create: if isSignedIn() && isClient()
        && request.resource.data.keys().hasOnly(['orgId', 'projectId', 'title', 'details', 'urgency', 'neededBy',
             'requestedBy', 'requestedByName', 'status', 'notified', 'createdAt'])
        && isOrgMember(request.resource.data.orgId)
        && request.resource.data.projectId in myProjectIds()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByName is string
        && request.resource.data.requestedByName.size() <= 120
        && request.resource.data.status == 'new'
        && request.resource.data.notified == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 4000
        && request.resource.data.urgency in ['normal', 'urgent']
        && (request.resource.data.neededBy == null
            || (request.resource.data.neededBy is string
                && request.resource.data.neededBy.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));

      // Answered once, by someone who runs the project, as themselves and at the server's
      // time; an accepted request names a task that really is in the same project.
      allow update: if isSignedIn() && !isClient()
        && canTriage(resource.data.get('orgId', null), resource.data.get('projectId', null))
        && resource.data.status == 'new'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'decidedBy', 'decidedByName', 'decidedAt', 'response', 'taskId', 'notified'])
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.decidedBy == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && request.resource.data.decidedByName is string
        && request.resource.data.decidedByName.size() <= 120
        && request.resource.data.response is string
        && request.resource.data.response.size() <= 2000
        && request.resource.data.notified == false
        && (request.resource.data.status == 'declined'
            || (request.resource.data.get('taskId', null) is string
                && taskData(request.resource.data.taskId).get('orgId', null) == resource.data.orgId
                && taskData(request.resource.data.taskId).get('projectId', null) == resource.data.projectId));

      allow delete: if isSignedIn() && (
        (isClient() && resource.data.get('requestedBy', null) == request.auth.uid
          && resource.data.get('status', null) == 'new')
        || isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null)));
    }

    // Task attachments (metadata; the files live in Storage, see storage.rules)
    match /task_attachments/{attachmentId} {
      allow read: if canSeeTask(resource.data.get('taskId', null));
      allow create: if canSeeTask(request.resource.data.get('taskId', null))
        && request.resource.data.get('uploadedBy', null) == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.get('uploadedBy', null) == request.auth.uid
        || isMasterAdmin()
        || canModerateTask(taskData(resource.data.get('taskId', null)))
      );
    }

    // @mention notifications. A notification may only be addressed to someone in
    // the sender's own organization and attributed to the sender; the recipient
    // may then read it, flip its `read` flag, or delete it - nothing else.
    match /comment_notifications/{notificationId} {
      // The recipient, or (so a deleted task can take its notifications with it)
      // whoever moderates the task.
      allow read, delete: if isSignedIn() && (resource.data.get('userId', null) == request.auth.uid
        || canModerateTask(taskData(resource.data.get('taskId', null))));
      allow update: if isSignedIn()
        && resource.data.get('userId', null) == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if isSignedIn() && !isClient()
        && request.resource.data.get('mentionedBy', null) == request.auth.uid
        && request.resource.data.get('userId', null) is string
        && get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.get('orgId', null) == myOrgId();
      // A client tells the task's author and assignee that they wrote, approved or asked
      // for changes, on a task of their own project, and nobody else.
      allow create: if isSignedIn() && isClient()
        && request.resource.data.keys().hasOnly(['userId', 'taskId', 'mentionedBy', 'mentionedByName', 'type',
             'taskTitle', 'excerpt', 'read', 'createdAt'])
        && request.resource.data.mentionedBy == request.auth.uid
        && request.resource.data.type in ['client_message', 'client_approved', 'client_changes_requested']
        && request.resource.data.read == false
        && taskData(request.resource.data.taskId).get('orgId', null) == myOrgId()
        && taskData(request.resource.data.taskId).get('projectId', null) in myProjectIds()
        && request.resource.data.userId is string
        && request.resource.data.userId in [taskData(request.resource.data.taskId).get('createdBy', null),
                                            taskData(request.resource.data.taskId).get('assignedTo', null)];
    }

    // Org usage stats â€” master-admin only
    match /org_usage_stats/{orgId} {
      allow read, write: if isSignedIn() && isMasterAdmin();
    }

    // Audit logs.
    // Master-admin sees everything. Org-admins read their organization's history
    // (the Activity log). Anyone who manages people there (org-admin, department
    // head, manager) appends entries for their own organization, as themselves and
    // stamped with the server's clock, so nobody can backdate or sign for someone
    // else. Entries are append-only: nobody may edit or delete history.
    match /audit_logs/{logId} {
      allow read: if isSignedIn() && (isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null)));
      allow create: if isSignedIn() && (isMasterAdmin()
        || (request.resource.data.get('actorId', null) == request.auth.uid
            && request.resource.data.get('timestamp', null) == request.time
            && (isOrgAdmin(request.resource.data.get('orgId', null))
                || ((isDeptHead() || isManager())
                    && isOrgMember(request.resource.data.get('orgId', null))))));
      allow update, delete: if false;
    }

    // Unhandled UI errors, written by the ErrorBoundary.
    // Any signed-in user may report one (a crash can happen on any screen), but
    // only a master-admin may read them: stacks and URLs can reveal other
    // organizations' data. Append-only â€” a report cannot be altered or removed,
    // so nobody can quietly erase evidence of a failure.
    match /error_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && isMasterAdmin();
      allow update, delete: if false;
    }

    // Outgoing email queue.
    //
    // The browser cannot send email, so it appends a request here and a
    // scheduled job delivers it through Gmail. That makes this collection the
    // one place a signed-in user can cause mail to leave the system, so the
    // shape is pinned down rather than trusted:
    //  - the request must be attributable to the caller (requestedBy == uid),
    //    so a queued email can never be blamed on someone else
    //  - it must start unsent, so nobody can pre-mark their own request
    //    delivered and skip the record of it
    //  - a recipient and a subject line are required, so an empty or
    //    malformed job cannot sit in the queue failing forever
    //  - nobody may read the queue: payloads carry names, task titles and
    //    addresses from whichever org queued them
    // Only the drain job (Admin SDK, which bypasses rules) marks them sent.
    match /mail_queue/{mailId} {
      // A request names its recipient by UID, never by address, and must be tied to
      // a task the caller can actually see. The recipient must belong to the
      // caller's own organization; the drain job then looks the address up itself
      // (and re-checks the account is active). So no one can direct mail at an
      // arbitrary outside address, choose a CC list, or add fields the template
      // does not know about. Only whitelisted template fields are accepted.
      allow create: if isSignedIn()
        && !isClient()
        && request.resource.data.keys().hasOnly([
             'recipientUid', 'notification_type', 'notification_icon',
             'notification_color', 'title', 'message',
             'detail_1_label', 'detail_1_value', 'detail_2_label', 'detail_2_value',
             'detail_3_label', 'detail_3_value', 'detail_4_label', 'detail_4_value',
             'detail_5_label', 'detail_5_value', 'button_text', 'button_link', 'footer_text',
             'status', 'attempts', 'requestedBy', 'requestedAt', 'type', 'taskId', 'source'])
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.attempts == 0
        && request.resource.data.get('recipientUid', null) is string
        && request.resource.data.recipientUid.size() > 0
        && request.resource.data.recipientUid.size() < 200
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 300
        && request.resource.data.notification_type is string
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 1000
        && request.resource.data.get('taskId', null) is string
        && canSeeTask(request.resource.data.taskId)
        && get(/databases/$(database)/documents/users/$(request.resource.data.recipientUid)).data.get('orgId', null) == myOrgId();
      allow read, update, delete: if false;
    }

    // Login attempts â€” Cloud Functions (Admin SDK) only
    match /login_attempts/{doc} {
      allow read, write: if false;
    }

    // Username lookup â€” readable by signed-in users, written server-side only
    match /usernames/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Designations (job titles) are per-organization. A designation without an
    // orgId is legacy data awaiting scripts/admin/backfill-designation-org.mjs.
    match /designations/{designationId} {
      allow read: if isSignedIn()
        && (isMasterAdmin() || isOrgMember(resource.data.get('orgId', null)));
      // Heads and managers hire into their own scope, so they need to be able
      // to add the job title they are hiring for without waiting on an admin.
      allow create: if isSignedIn()
        && myRole() in ['admin', 'org-admin', 'master-admin', 'department-head', 'manager']
        && (isMasterAdmin() || request.resource.data.get('orgId', null) == myOrgId());
      allow update: if isSignedIn()
        && myRole() in ['admin', 'org-admin', 'master-admin', 'department-head', 'manager']
        && (isMasterAdmin() || resource.data.get('orgId', null) == myOrgId())
        && request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
      allow delete: if isSignedIn()
        && myRole() in ['admin', 'org-admin', 'master-admin', 'department-head', 'manager']
        && (isMasterAdmin() || resource.data.get('orgId', null) == myOrgId());
    }

    // Email logs
    match /email_logs/{logId} {
      // Scoped to the org-admin own organization (the drain job stamps orgId).
      allow read: if isSignedIn() && (isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null)));
      allow write: if false; // written server-side only
    }

    // Reminder logs
    match /reminder_logs/{date} {
      allow read: if isSignedIn() && myRole() in ['admin', 'org-admin', 'master-admin'];
      allow write: if false;
    }

    // User deletion markers.
    // On the Spark plan the client cannot delete a Firebase Auth account, so a
    // removed user leaves an orphaned sign-in that keeps their email reserved.
    // Admins record and later clear these markers; they are never deleted, so
    // the record of the removal survives.
    match /userDeletions/{uid} {
      allow read: if isSignedIn() && (isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null)));
      allow create: if isSignedIn() && (isMasterAdmin() || isOrgAdmin(request.resource.data.get('orgId', null)));
      // Only the cleanup bookkeeping may change â€” the identity fields are fixed.
      allow update: if isSignedIn() && (isMasterAdmin() || isOrgAdmin(resource.data.get('orgId', null)))
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
      allow delete: if false;
    }
  }
}




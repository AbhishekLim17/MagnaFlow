rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function myRole() { return me().role; }
    function isMasterAdmin() { return isSignedIn() && myRole() == 'master-admin'; }
    // The live app is a single-tenant admin/staff system. "admin"/"org-admin" are
    // treated as full administrators; "master-admin" is the super admin.
    function isAdmin() { return isSignedIn() && myRole() in ['admin', 'org-admin', 'master-admin']; }
    function isOrgMember(orgId) { return isSignedIn() && me().orgId == orgId; }
    function isOrgAdmin(orgId) { return isOrgMember(orgId) && (me().role == 'org-admin' || me().role == 'admin'); }
    function isDeptMember(orgId, deptId) { return isOrgMember(orgId) && deptId in me().departmentIds; }
    function isProjectMember(orgId, projId) { return isOrgMember(orgId) && projId in me().projectIds; }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId) || isMasterAdmin();
      allow write: if isMasterAdmin();

      match /departments/{deptId} {
        allow read: if isDeptMember(orgId, deptId) || isOrgAdmin(orgId) || isMasterAdmin();
        allow write: if isOrgAdmin(orgId) || isMasterAdmin();
      }
      match /projects/{projId} {
        allow read: if isProjectMember(orgId, projId) || isOrgAdmin(orgId) || isMasterAdmin();
        allow write: if isOrgAdmin(orgId) || isMasterAdmin();
      }
      match /tasks/{taskId} {
        allow read: if isOrgAdmin(orgId) || isMasterAdmin()
                     || isProjectMember(orgId, resource.data.projectId)
                     || isDeptMember(orgId, resource.data.departmentId);
        allow create: if isOrgAdmin(orgId) || isMasterAdmin()
                     || isProjectMember(orgId, request.resource.data.projectId);
        allow update, delete: if isOrgAdmin(orgId) || isMasterAdmin()
                     || isProjectMember(orgId, resource.data.projectId);
      }
    }

    // Users — primary collection for the admin/staff app.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Only admins create or delete user documents.
      allow create, delete: if isAdmin();

      // Admins can update any user. A user may update their OWN document but must
      // NOT be able to change their role or account status (privilege escalation).
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && request.resource.data.status == resource.data.status);
    }

    // Tasks — primary collection for the admin/staff app.
    match /tasks/{taskId} {
      allow read: if isSignedIn() && (
        isAdmin()
        || resource.data.assignedTo == request.auth.uid
        || resource.data.createdBy == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isAdmin()
        || request.resource.data.createdBy == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin()
        || resource.data.assignedTo == request.auth.uid
        || resource.data.createdBy == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        isAdmin()
        || resource.data.createdBy == request.auth.uid
      );
    }

    // Subtasks
    match /subtasks/{subtaskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Task comments
    match /task_comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isMasterAdmin()
      );
    }

    // Task attachments
    match /task_attachments/{attachmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource.data.uploadedBy == request.auth.uid || isMasterAdmin()
      );
    }

    // Notifications
    match /comment_notifications/{notificationId} {
      allow read, write: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // Org usage stats — master-admin only
    match /org_usage_stats/{orgId} {
      allow read, write: if isMasterAdmin();
    }

    // Audit logs — master-admin only
    match /audit_logs/{logId} {
      allow read, write: if isMasterAdmin();
    }

    // Login attempts — Cloud Functions (Admin SDK) only
    match /login_attempts/{doc} {
      allow read, write: if false;
    }

    // Username lookup — readable by signed-in users, written server-side only
    match /usernames/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Designations
    match /designations/{designationId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && me().role in ['admin', 'org-admin', 'master-admin'];
    }

    // Email logs
    match /email_logs/{logId} {
      allow read: if isMasterAdmin() || (isSignedIn() && me().role in ['admin', 'org-admin']);
      allow write: if false; // written server-side only
    }

    // Reminder logs
    match /reminder_logs/{date} {
      allow read: if isSignedIn() && me().role in ['admin', 'org-admin', 'master-admin'];
      allow write: if false;
    }

    // User deletion markers
    match /userDeletions/{uid} {
      allow read: if isSignedIn() && me().role in ['admin', 'org-admin', 'master-admin'];
      allow write: if false;
    }
  }
}
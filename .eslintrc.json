{
  "extends": [
    "react-app",
    "react-app/jest"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "react/prop-types": "off",
    "react/display-name": "off",
    "no-console": ["warn", { "allow": ["error", "warn"] }]
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  }
}
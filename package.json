{
  "name": "web-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "node tools/generate-llms.js && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test:rules": "firebase emulators:exec --only firestore --project demo-magnaflow --config firebase.test.json \"vitest run --config vitest.rules.config.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:staging": "npm run build && firebase hosting:channel:deploy staging --expires 30d",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-magnaflow --config firebase.test.json",
    "seed": "node scripts/seed-emulator.cjs",
    "seed:scale": "node scripts/seed-scale.cjs",
    "dev:emulated": "vite --mode emulated",
    "check:secrets": "node scripts/check-secrets.cjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.5.0",
    "framer-motion": "^11.15.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.16.0",
    "recharts": "^2.8.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.8.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.1",
    "eslint-config-react-app": "^7.0.1",
    "firebase-admin": "^12.0.0",
    "firebase-tools": "^15.25.0",
    "jsdom": "^29.1.1",
    "nodemailer": "^9.0.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "terser": "^5.39.0",
    "vite": "^7.2.6",
    "vitest": "^4.1.10"
  }
}

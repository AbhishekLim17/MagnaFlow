# Local emulator run only. Loaded by `vite --mode emulated`.
# The values are placeholders: the emulators accept any project config.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-magnaflow.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-magnaflow
VITE_FIREBASE_STORAGE_BUCKET=demo-magnaflow.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Fake Google/Microsoft sign-in (the Auth emulator stands in for both; see docs/SSO_SETUP.md)
VITE_SIGNIN_PROVIDERS=google,microsoft

# Email-to-task: the mailbox shown in project addresses (scripts/lib/inbound.cjs reads it)
VITE_INBOUND_MAILBOX=magnaflow.demo@gmail.com

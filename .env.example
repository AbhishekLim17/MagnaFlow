# MagnaFlow — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Firebase ────────────────────────────────────────────────────────────────
# Client-side config only — public by design, safe to expose in the bundle.
# The Firestore security rules are what actually guard the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Email CC list (comma-separated) ─────────────────────────────────────────
# Addresses copied on assignment / critical-task notifications.
# Example: VITE_CC_EMAILS=admin@company.com,manager@company.com
VITE_CC_EMAILS=

# Sending itself is server-side (Gmail via a scheduled GitHub Action —
# see scripts/lib/mailer.cjs) and needs GMAIL_USER / GMAIL_APP_PASSWORD
# as repository secrets, not env vars here.

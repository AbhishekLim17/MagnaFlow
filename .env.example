# MagnaFlow — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# ── Firebase ────────────────────────────────────────────────────────────────
# Client-side config only — public by design, safe to expose in the bundle.
# The Firestore security rules are what actually guard the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Sending itself is server-side (Gmail via a scheduled GitHub Action —
# see scripts/lib/mailer.cjs) and needs GMAIL_USER / GMAIL_APP_PASSWORD
# as repository secrets, not env vars here.

# Cloud Functions are unavailable on the Spark plan; leave unset. Set to true only after
# deploying functions/ (Blaze plan) to re-enable the login rate limit and server-side user deletion.
# VITE_FUNCTIONS_ENABLED=true

# Google / Microsoft sign-in (optional, off when unset). Enable the providers in Firebase first:
# docs/SSO_SETUP.md. Values: google, microsoft, or google,microsoft
# VITE_SIGNIN_PROVIDERS=google

# App Check (optional). Public reCAPTCHA v3 site key - see docs/APP_CHECK_SETUP.md
# VITE_APPCHECK_SITE_KEY=
